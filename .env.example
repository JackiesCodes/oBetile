# Copy to .env.local and fill in real values. .env.local is git-ignored.

# API-Football — https://dashboard.api-football.com
# Server-side only. Do NOT prefix with NEXT_PUBLIC_, that would ship the key
# to the browser where anyone can read it and burn your quota.
APIFOOTBALL_KEY=

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Optional: the local copy of the football data (see docs/sync.md) ---
# Without these two the app runs exactly as before, reading live from
# API-Football; /api/sync answers 503 and the local tables stay empty.

# Lets the sync job write. The football tables grant select to everyone and
# insert to nobody, so only the service role can populate them. Server-side
# only — prefixing this NEXT_PUBLIC_ would hand full database access to every
# visitor's browser.
SUPABASE_SERVICE_ROLE_KEY=

# Authorises /api/sync. Vercel sends it as a bearer token on scheduled runs.
# Without it the endpoint denies everything rather than letting strangers spend
# the upstream request allowance.
CRON_SECRET=
